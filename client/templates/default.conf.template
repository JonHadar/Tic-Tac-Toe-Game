server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # API requests go to the Express server. API_UPSTREAM is filled in when the
    # container starts (default http://server:5000, set in the Dockerfile).
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Vite puts content-hashed files in /assets, so they can be cached forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
